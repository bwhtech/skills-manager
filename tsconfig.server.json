{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["bun"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    // src tests (e.g. src/lib/upstream.test.ts) import the contract as src does.
    "paths": { "@shared/*": ["./shared/*"] }
  },
  "include": ["server", "shared", "src/**/*.test.ts"]
}
