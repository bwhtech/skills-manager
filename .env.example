# Skills Manager settings. Copy to .env and fill in for this server.
# Bun loads .env from the working directory (the server and `bun test`);
# Vite and scripts/deploy.sh read it too. .env is git-ignored.

# Where the server listens. The UI and /api share this port.
PORT=3530
HOST=127.0.0.1

# Port of the Vite dev server (`bun run dev`). It proxies /api to PORT.
SKILLS_MANAGER_DEV_PORT=5530

# Host names the API answers to, besides localhost, 127.0.0.1 and [::1].
# Comma-separated, no ports. Example: a Tailscale Serve name.
SKILLS_MANAGER_ALLOWED_HOSTS=my-server.example.ts.net

# Folders besides HOME whose files the file viewer may show (and Markdown files save).
# Comma-separated absolute paths; ~ means HOME.
SKILLS_MANAGER_FILE_ROOTS=

# Folders the project scan never enters. Comma-separated; ~ means HOME.
SKILLS_MANAGER_SCAN_SKIP=

# Optional GitHub token for `skills check` / update and update previews.
# When unset, the server runs `gh auth token`.
# GITHUB_TOKEN=

# Production (scripts/deploy.sh): the detached worktree it deploys to (default: <repo>-live),
# the systemd user unit it restarts, and the URL it prints.
SKILLS_MANAGER_LIVE_DIR=
SKILLS_MANAGER_UNIT=skills-manager
SKILLS_MANAGER_PUBLIC_URL=
